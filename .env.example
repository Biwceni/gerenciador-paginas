# Copie para .env e preencha. Nunca coloque valores reais neste arquivo.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables
# (Supabase dev para Preview/Development, Supabase produção para Production).

# Endereço público do site. Na Vercel pode ficar vazio (usa o domínio da Vercel).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload: texto aleatório e longo (ex.: `openssl rand -hex 32`). Um diferente por ambiente.
PAYLOAD_SECRET=

# Supabase Postgres. Use a "connection string" do pooler (Transaction, porta 6543) para a Vercel.
DATABASE_URL=

# Supabase Storage (S3). Em Project Settings > Storage > S3 Connection.
S3_ENDPOINT=https://<projeto>.storage.supabase.co/storage/v1/s3
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endereço público do bucket (bucket marcado como público no Supabase).
S3_PUBLIC_URL=https://<projeto>.supabase.co/storage/v1/object/public/<bucket>

# Resend (e-mail de recuperação de senha). Sem a chave, os e-mails aparecem só no terminal.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
